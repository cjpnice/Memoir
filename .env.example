PORT=8090
DATA_DIR=./data

# Empty means permissive local-development CORS. For deployment, set explicit origins.
# Example: ALLOWED_ORIGINS=https://memoir.example.com,http://localhost:3000
ALLOWED_ORIGINS=

# Import guardrails. Increase for trusted machines with enough disk and memory.
MAX_UPLOAD_MB=256
MAX_UPLOAD_FILES=200

# Optional. Pin a Chrome/Chromium binary for PDF export when auto-detection fails.
CHROME_PATH=

# Internal HTTP address used by the backend Chrome renderer for image export.
# Leave empty for local development; set this in Docker if Chrome reaches the API
# through a service name, for example http://memoir-api:8090.
INTERNAL_BASE_URL=

# Frontend dev client calls the Go API directly to avoid Next.js upload body limits.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8090

# OpenAI-compatible multimodal model config. The model must support image input.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible image edit model config. Falls back to the multimodal
# Base URL/API key at startup when these are empty.
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
